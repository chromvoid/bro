{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "vite.config.ts",
    "tooling/**/*.ts",
    "playwright*.config.ts",
    "e2e/**/*",
    "e2e-agent/**/*"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}

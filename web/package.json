{
  "name": "device-assistant-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run palette:check && npm run types && npm run lint && npm run check:plugins && npm run format:check",
    "types": "vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check . ../plugins/*/web --config .prettierrc.json --ignore-path .prettierignore",
    "palette:generate": "python3 tooling/generate_palette.py && python3 tooling/generate_android_strings.py && node tooling/generate_android_icons.mjs",
    "palette:check": "python3 tooling/generate_palette.py --check && python3 tooling/generate_android_strings.py --check && node tooling/generate_android_icons.mjs --check && python3 -B -m unittest discover -s tooling -p 'test_generate_*.py' -q",
    "strings:generate": "python3 tooling/generate_android_strings.py",
    "strings:check": "python3 tooling/generate_android_strings.py --check",
    "format": "prettier --write . ../plugins/*/web --config .prettierrc.json --ignore-path .prettierignore",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:agent": "playwright test --config playwright.agent.config.ts",
    "check:plugins": "cd .. && web/node_modules/.bin/eslint --config plugins/eslint.config.mjs --max-warnings 0 plugins/*/web"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/vue": "1.48.0",
    "@tanstack/vue-query": "5.103.2",
    "@tanstack/vue-virtual": "3.13.39",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb": "8.0.3",
    "leaflet": "1.9.4",
    "markdown-it": "15.0.2",
    "pinia": "4.0.3",
    "reka-ui": "2.10.5",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "vue": "3.5.43",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.12",
    "vue-router": "5.3.1",
    "vue-sonner": "2.0.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@intlify/unplugin-vue-i18n": "11.2.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11"
  }
}

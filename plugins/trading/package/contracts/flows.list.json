{
 "id": "flows.list",
 "version": "1.1.0",
 "description": "Все движения средств вне торговли по единому счёту, Funding и Earn из журналов самой Bybit: вводы и выводы, P2P-продажи и покупки, переводы между счетами, Earn (вложение, выкуп, доход), переводы ботам, бонусы и аирдропы. Итоги считают только то, что пришло извне или ушло наружу, в USD на момент операции.",
 "when_to_use": "Сколько денег заведено или выведено всего (включая P2P), переводы между счетами, доход Earn, куда ушли или откуда пришли монеты.",
 "when_not_to_use": "Сделки (executions.list); статус, сеть и хэш конкретного ввода или вывода (cashflow.list); текущие балансы (portfolio.get).",
 "input_schema": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "range": {
    "oneOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "period"
      ],
      "properties": {
       "period": {
        "enum": [
         "today",
         "24h",
         "7d",
         "30d",
         "90d",
         "this_week",
         "this_month",
         "this_year",
         "1y",
         "all"
        ]
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "from"
      ],
      "properties": {
       "from": {
        "type": "string",
        "format": "date-time",
        "maxLength": 40
       },
       "to": {
        "type": "string",
        "format": "date-time",
        "maxLength": 40
       }
      }
     }
    ]
   },
   "kinds": {
    "type": "array",
    "uniqueItems": true,
    "items": {
     "enum": [
      "deposit",
      "withdrawal",
      "transfer",
      "p2p",
      "earn",
      "bot",
      "reward",
      "interest",
      "convert",
      "other"
     ]
    }
   },
   "accounts": {
    "type": "array",
    "minItems": 1,
    "uniqueItems": true,
    "items": {
     "enum": [
      "unified",
      "funding"
     ]
    }
   },
   "coin": {
    "type": "string",
    "pattern": "^[A-Z0-9]{1,20}$"
   },
   "internal": {
    "type": "boolean",
    "default": true,
    "description": "Показывать и перемещения между своими счетами (Funding ↔ единый, вложения в Earn и выкуп)"
   },
   "limit": {
    "type": "integer",
    "minimum": 1,
    "maximum": 200,
    "default": 50
   },
   "cursor": {
    "type": "string",
    "pattern": "^[A-Za-z0-9_-]{1,300}$"
   }
  },
  "required": []
 },
 "output_schema": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "items": {
    "type": "array",
    "maxItems": 200,
    "items": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string",
       "maxLength": 200
      },
      "account": {
       "enum": [
        "unified",
        "funding"
       ]
      },
      "kind": {
       "enum": [
        "deposit",
        "withdrawal",
        "transfer",
        "p2p",
        "earn",
        "bot",
        "reward",
        "interest",
        "convert",
        "other"
       ]
      },
      "operation": {
       "enum": [
        "convert",
        "transfer",
        "deposit",
        "internal_deposit",
        "withdrawal",
        "internal_withdrawal",
        "p2p_sale",
        "p2p_sale_cancelled",
        "p2p_purchase",
        "earn_stake",
        "earn_redeem",
        "earn_reward",
        "earn_other",
        "bot_transfer",
        "airdrop",
        "bonus",
        "fee_refund",
        "interest",
        "other"
       ]
      },
      "direction": {
       "enum": [
        "in",
        "out"
       ]
      },
      "coin": {
       "type": "string",
       "pattern": "^[A-Z0-9]{1,20}$"
      },
      "amount": {
       "type": "string",
       "format": "decimal",
       "maxLength": 64
      },
      "counterparty": {
       "enum": [
        "unified",
        "funding",
        "spot",
        "earn",
        "chain",
        "bybit_user",
        "p2p",
        "bybit",
        "bot",
        "market",
        null
       ]
      },
      "external": {
       "type": "boolean"
      },
      "balance_after": {
       "type": [
        "string",
        "null"
       ],
       "format": "decimal",
       "maxLength": 64
      },
      "note": {
       "type": [
        "string",
        "null"
       ],
       "maxLength": 200
      },
      "occurred_at": {
       "type": "string",
       "format": "date-time",
       "maxLength": 40
      },
      "usd_value_at_event": {
       "type": [
        "string",
        "null"
       ],
       "format": "decimal",
       "maxLength": 64
      },
      "markable": {
       "type": "boolean"
      },
      "treatment": {
       "enum": [
        "auto",
        "own_wallet",
        "external"
       ]
      },
      "unit_cost_usd": {
       "type": [
        "string",
        "null"
       ],
       "format": "decimal",
       "maxLength": 64
      }
     },
     "required": [
      "id",
      "account",
      "kind",
      "operation",
      "direction",
      "coin",
      "amount",
      "counterparty",
      "external",
      "balance_after",
      "note",
      "occurred_at",
      "usd_value_at_event",
      "markable",
      "treatment",
      "unit_cost_usd"
     ]
    }
   },
   "totals": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "by_coin": {
      "type": "array",
      "maxItems": 500,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "coin": {
         "type": "string",
         "pattern": "^[A-Z0-9]{1,20}$"
        },
        "in": {
         "type": "string",
         "format": "decimal",
         "maxLength": 64
        },
        "out": {
         "type": "string",
         "format": "decimal",
         "maxLength": 64
        },
        "net": {
         "type": "string",
         "format": "decimal",
         "maxLength": 64
        }
       },
       "required": [
        "coin",
        "in",
        "out",
        "net"
       ]
      }
     },
     "by_kind": {
      "type": "array",
      "maxItems": 20,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "kind": {
         "enum": [
          "deposit",
          "withdrawal",
          "transfer",
          "p2p",
          "earn",
          "bot",
          "reward",
          "interest",
          "convert",
          "other"
         ]
        },
        "count": {
         "type": "integer",
         "minimum": 0
        },
        "usd_in": {
         "type": "string",
         "format": "decimal",
         "maxLength": 64
        },
        "usd_out": {
         "type": "string",
         "format": "decimal",
         "maxLength": 64
        }
       },
       "required": [
        "kind",
        "count",
        "usd_in",
        "usd_out"
       ]
      }
     },
     "usd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "in": {
        "type": "string",
        "format": "decimal",
        "maxLength": 64
       },
       "out": {
        "type": "string",
        "format": "decimal",
        "maxLength": 64
       },
       "net": {
        "type": "string",
        "format": "decimal",
        "maxLength": 64
       },
       "unpriced_count": {
        "type": "integer",
        "minimum": 0
       }
      },
      "required": [
       "in",
       "out",
       "net",
       "unpriced_count"
      ]
     },
     "by_month": {
      "type": "array",
      "maxItems": 24,
      "description": "Пришло и ушло (в USD по цене события) по календарным месяцам в часовом поясе пользователя: от первого месяца с движением, не больше 24, до текущего",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "month": {
         "type": "string",
         "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "usd_in": {
         "type": "string",
         "format": "decimal",
         "maxLength": 64
        },
        "usd_out": {
         "type": "string",
         "format": "decimal",
         "maxLength": 64
        }
       },
       "required": [
        "month",
        "usd_in",
        "usd_out"
       ]
      }
     }
    },
    "required": [
     "by_coin",
     "by_kind",
     "usd",
     "by_month"
    ]
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ],
    "maxLength": 300
   },
   "freshness": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "as_of",
     "connection_state",
     "stream",
     "history_complete",
     "coverage_from",
     "last_reconcile_at"
    ],
    "properties": {
     "as_of": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     },
     "connection_state": {
      "enum": [
       "not_configured",
       "validating",
       "active",
       "degraded",
       "auth_failed",
       "ip_blocked",
       "key_expired",
       "secret_unavailable",
       "disconnected"
      ]
     },
     "stream": {
      "enum": [
       "live",
       "reconnecting",
       "down"
      ]
     },
     "last_reconcile_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     },
     "history_complete": {
      "type": "boolean"
     },
     "coverage_from": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     }
    }
   }
  },
  "required": [
   "items",
   "totals",
   "next_cursor",
   "freshness"
  ]
 },
 "effect": "read",
 "scopes": [
  "trading.read"
 ],
 "surfaces": [
  "ui",
  "agent"
 ],
 "execution": {
  "mode": "sync",
  "max_duration_ms": 5000
 },
 "errors": [
  {
   "code": "not_configured",
   "meaning": "Ключ Bybit не подключён; данных нет",
   "recovery": "none"
  }
 ],
 "limits": {
  "max_response_bytes": 262144
 }
}

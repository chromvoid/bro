     "string",
     "null"
    ],
    "format": "decimal",
    "maxLength": 64
   },
   "cycle_started_at": {
    "type": [
     "string",
     "null"
    ],
    "format": "date-time",
    "maxLength": 40
   },
   "realized_in_cycle": {
    "type": [
     "string",
     "null"
    ],
    "format": "decimal",
    "maxLength": 64
   },
   "mark": {
    "type": [
     "string",
     "null"
    ],
    "format": "decimal",
    "maxLength": 64
   },
   "unrealized": {
    "type": [

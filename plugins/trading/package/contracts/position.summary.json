     "fifo"
    ]
   },
   "coin": {
    "type": "string",
    "pattern": "^[A-Z0-9]{1,20}$"
   },
   "open_qty": {
    "type": "string",
    "format": "decimal",
    "maxLength": 64
   },
   "value": {
    "type": [
     "string",
     "null"
    ],
    "format": "decimal",
    "maxLength": 64
   },
   "held_qty": {
    "type": [
     "string",
     "null"
    ],
    "format": "decimal",
    "maxLength": 64
   },
   "unexplained_qty": {
    "type": [
     "string",
     "null"
    ],
    "format": "decimal",
    "maxLength": 64
   },
   "traded_against": {
    "type": [
     "string",
     "null"
    ],
    "pattern": "^[A-Z0-9]{1,20}$"
   },
   "closed": {
    "type": "boolean",
    "description": "Позиция закрыта: монета распродана или остаток — пыль (меньше 10 $)"
   },
   "result": {
    "type": [

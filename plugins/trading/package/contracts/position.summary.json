      "type": "string",
      "format": "decimal",
      "maxLength": 64
     },
     "since": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
     },
     "entry": {
      "type": [
       "string",
       "null"
      ],
      "format": "decimal",
      "maxLength": 64
     },
     "unrealized": {
      "type": [
       "string",
       "null"
      ],
      "format": "decimal",
      "maxLength": 64
     },
     "sold_qty": {

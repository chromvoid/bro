{
 "id": "portfolio.history",
 "version": "1.2.0",
 "description": "История суммарной стоимости спотового портфеля в USD с шагом час, день или неделя. У каждой точки после первой — чистый ввод-вывод средств с предыдущей (flow_usd). Для шагов в день и в неделю интервал без снимка (до начала снимков или в промежутке между ними) показывает стоимость, восстановленную по сделкам, движениям средств и дневным ценам на его конец (rebuilt: true); earliest_available — самое раннее время со стоимостью, снимком или восстановленной.",
 "when_to_use": "Графики и вопросы о том, как менялась стоимость портфеля за период.",
 "when_not_to_use": "Текущие балансы (portfolio.get). История начинается с момента подключения ключа.",
 "input_schema": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "range": {
    "oneOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "period"
      ],
      "properties": {
       "period": {
        "enum": [
         "today",
         "24h",
         "7d",
         "30d",
         "90d",
         "this_week",
         "this_month",
         "this_year",
         "1y",
         "all"
        ]
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "from"
      ],
      "properties": {
       "from": {
        "type": "string",
        "format": "date-time",
        "maxLength": 40
       },
       "to": {
        "type": "string",
        "format": "date-time",
        "maxLength": 40
       }
      }
     }
    ]
   },
   "step": {
    "enum": [
     "1h",
     "1d",
     "1w"
    ]
   },
   "include_coins": {
    "type": "boolean",
    "default": false
   }
  },
  "required": [
   "range",
   "step"
  ]
 },
 "output_schema": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "points": {
    "type": "array",
    "maxItems": 1000,
    "items": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "time": {
       "type": "string",
       "format": "date-time",
       "maxLength": 40
      },
      "total_usd": {
       "type": "string",
       "format": "decimal",
       "maxLength": 64
      },
      "flow_usd": {
       "type": [
        "string",
        "null"
       ],
       "format": "decimal",
       "maxLength": 64,
       "description": "Ввод минус вывод (в USD по цене события) с предыдущей точки: изменение стоимости его включает; null для первой точки или без цены"
      },
      "rebuilt": {
       "type": "boolean",
       "description": "Стоимость восстановлена по истории, а не снята со счетов"
      },
      "coins": {
       "type": "array",
       "maxItems": 500,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "coin": {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,20}$"
         },
         "quantity": {
          "type": "string",
          "format": "decimal",
          "maxLength": 64
         },
         "usd_value": {
          "type": [
           "string",
           "null"
          ],
          "format": "decimal",
          "maxLength": 64
         }
        },
        "required": [
         "coin",
         "quantity",
         "usd_value"
        ]
       }
      }
     },
     "required": [
      "time",
      "total_usd",
      "rebuilt"
     ]
    }
   },
   "earliest_available": {
    "type": [
     "string",
     "null"
    ],
    "format": "date-time",
    "maxLength": 40
   },
   "freshness": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "as_of",
     "connection_state",
     "stream",
     "history_complete",
     "coverage_from",
     "last_reconcile_at"
    ],
    "properties": {
     "as_of": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     },
     "connection_state": {
      "enum": [
       "not_configured",
       "validating",
       "active",
       "degraded",
       "auth_failed",
       "ip_blocked",
       "key_expired",
       "secret_unavailable",
       "disconnected"
      ]
     },
     "stream": {
      "enum": [
       "live",
       "reconnecting",
       "down"
      ]
     },
     "last_reconcile_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     },
     "history_complete": {
      "type": "boolean"
     },
     "coverage_from": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     }
    }
   }
  },
  "required": [
   "points",
   "earliest_available",
   "freshness"
  ]
 },
 "effect": "read",
 "scopes": [
  "trading.read"
 ],
 "surfaces": [
  "ui",
  "agent"
 ],
 "execution": {
  "mode": "sync",
  "max_duration_ms": 5000
 },
 "errors": [
  {
   "code": "not_configured",
   "meaning": "Ключ Bybit не подключён; данных нет",
   "recovery": "none"
  },
  {
   "code": "range_too_large",
   "meaning": "Слишком много точек для выбранного шага",
   "recovery": "fix_arguments"
  }
 ],
 "limits": {
  "max_response_bytes": 262144
 }
}

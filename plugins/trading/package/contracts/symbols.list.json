{
 "id": "symbols.list",
 "version": "1.0.0",
 "description": "Спотовые пары, по которым были сделки, с количеством сделок и временем последней.",
 "when_to_use": "Узнать, какими парами торговал пользователь.",
 "when_not_to_use": "Балансы монет (portfolio.get).",
 "input_schema": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "type": "integer",
    "minimum": 1,
    "maximum": 200,
    "default": 50
   }
  },
  "required": []
 },
 "output_schema": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "items": {
    "type": "array",
    "maxItems": 200,
    "items": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "symbol": {
       "type": "string",
       "pattern": "^[A-Z0-9]{2,24}$"
      },
      "base_coin": {
       "type": "string",
       "pattern": "^[A-Z0-9]{1,20}$"
      },
      "quote_coin": {
       "type": "string",
       "pattern": "^[A-Z0-9]{1,20}$"
      },
      "executions_count": {
       "type": "integer",
       "minimum": 0
      },
      "last_exec_at": {
       "type": [
        "string",
        "null"
       ],
       "format": "date-time",
       "maxLength": 40
      }
     },
     "required": [
      "symbol",
      "base_coin",
      "quote_coin",
      "executions_count",
      "last_exec_at"
     ]
    }
   },
   "freshness": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "as_of",
     "connection_state",
     "stream",
     "history_complete",
     "coverage_from",
     "last_reconcile_at"
    ],
    "properties": {
     "as_of": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     },
     "connection_state": {
      "enum": [
       "not_configured",
       "validating",
       "active",
       "degraded",
       "auth_failed",
       "ip_blocked",
       "key_expired",
       "secret_unavailable",
       "disconnected"
      ]
     },
     "stream": {
      "enum": [
       "live",
       "reconnecting",
       "down"
      ]
     },
     "last_reconcile_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     },
     "history_complete": {
      "type": "boolean"
     },
     "coverage_from": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     }
    }
   }
  },
  "required": [
   "items",
   "freshness"
  ]
 },
 "effect": "read",
 "scopes": [
  "trading.read"
 ],
 "surfaces": [
  "ui",
  "agent"
 ],
 "execution": {
  "mode": "sync",
  "max_duration_ms": 5000
 },
 "errors": [
  {
   "code": "not_configured",
   "meaning": "Ключ Bybit не подключён; данных нет",
   "recovery": "none"
  }
 ],
 "limits": {
  "max_response_bytes": 262144
 }
}

{
 "id": "orders.history",
 "version": "1.0.0",
 "description": "История закрытых спотовых ордеров: по умолчанию по времени создания, новые первыми, без активных ордеров (их отдаёт orders.open или явный statuses). Со сделками — до 20 ордеров на страницу и до 25 сделок на ордер; fills_total говорит, сколько их всего, остальные — executions.list с order_id. Курсор действует только для того же запроса.",
 "when_to_use": "Вопросы о прошлых ордерах: исполненных, отменённых, по паре или периоду.",
 "when_not_to_use": "Открытые ордера (orders.open).",
 "input_schema": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "symbol": {
    "type": "string",
    "pattern": "^[A-Z0-9]{2,24}$"
   },
   "side": {
    "enum": [
     "buy",
     "sell"
    ]
   },
   "statuses": {
    "type": "array",
    "maxItems": 10,
    "uniqueItems": true,
    "items": {
     "enum": [
      "New",
      "PartiallyFilled",
      "Untriggered",
      "Filled",
      "Cancelled",
      "PartiallyFilledCanceled",
      "Rejected",
      "Deactivated",
      "Triggered",
      "Active"
     ]
    }
   },
   "range": {
    "oneOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "period"
      ],
      "properties": {
       "period": {
        "enum": [
         "today",
         "24h",
         "7d",
         "30d",
         "90d",
         "this_week",
         "this_month",
         "this_year",
         "1y",
         "all"
        ]
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "from"
      ],
      "properties": {
       "from": {
        "type": "string",
        "format": "date-time",
        "maxLength": 40
       },
       "to": {
        "type": "string",
        "format": "date-time",
        "maxLength": 40
       }
      }
     }
    ]
   },
   "has_tp_sl": {
    "type": "boolean"
   },
   "sort": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "field": {
      "enum": [
       "updated_at",
       "created_at",
       "volume"
      ]
     },
     "direction": {
      "enum": [
       "asc",
       "desc"
      ]
     }
    },
    "required": [
     "field",
     "direction"
    ]
   },
   "include_fills": {
    "type": "boolean",
    "default": false
   },
   "limit": {
    "type": "integer",
    "minimum": 1,
    "maximum": 200,
    "default": 50
   },
   "cursor": {
    "type": "string",
    "pattern": "^[A-Za-z0-9_-]{1,200}$"
   }
  },
  "required": []
 },
 "output_schema": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "items": {
    "type": "array",
    "maxItems": 200,
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "order_id",
      "order_link_id",
      "symbol",
      "base_coin",
      "quote_coin",
      "side",
      "type",
      "status",
      "price",
      "qty",
      "filled_qty",
      "filled_value",
      "avg_price",
      "fee",
      "trigger_price",
      "take_profit",
      "stop_loss",
      "time_in_force",
      "created_at",
      "updated_at"
     ],
     "properties": {
      "order_id": {
       "type": "string",
       "maxLength": 64
      },
      "order_link_id": {
       "type": [
        "string",
        "null"
       ],
       "maxLength": 64
      },
      "symbol": {
       "type": "string",
       "pattern": "^[A-Z0-9]{2,24}$"
      },
      "base_coin": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^[A-Z0-9]{1,20}$"
      },
      "quote_coin": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^[A-Z0-9]{1,20}$"
      },
      "side": {
       "enum": [
        "buy",
        "sell"
       ]
      },
      "type": {
       "type": "string",
       "maxLength": 20
      },
      "status": {
       "type": "string",
       "maxLength": 40
      },
      "price": {
       "type": [
        "string",
        "null"
       ],
       "format": "decimal",
       "maxLength": 64
      },
      "qty": {
       "type": "string",
       "format": "decimal",
       "maxLength": 64
      },
      "filled_qty": {
       "type": "string",
       "format": "decimal",
       "maxLength": 64
      },
      "filled_value": {
       "type": "string",
       "format": "decimal",
       "maxLength": 64
      },
      "avg_price": {
       "type": [
        "string",
        "null"
       ],
       "format": "decimal",
       "maxLength": 64
      },
      "fee": {
       "type": [
        "string",
        "null"
       ],
       "format": "decimal",
       "maxLength": 64
      },
      "trigger_price": {
       "type": [
        "string",
        "null"
       ],
       "format": "decimal",
       "maxLength": 64
      },
      "take_profit": {
       "type": [
        "string",
        "null"
       ],
       "format": "decimal",
       "maxLength": 64
      },
      "stop_loss": {
       "type": [
        "string",
        "null"
       ],
       "format": "decimal",
       "maxLength": 64
      },
      "time_in_force": {
       "type": [
        "string",
        "null"
       ],
       "maxLength": 20
      },
      "created_at": {
       "type": "string",
       "format": "date-time",
       "maxLength": 40
      },
      "updated_at": {
       "type": "string",
       "format": "date-time",
       "maxLength": 40
      },
      "fills": {
       "type": "array",
       "maxItems": 25,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "exec_id",
         "order_id",
         "symbol",
         "base_coin",
         "quote_coin",
         "side",
         "price",
         "qty",
         "value",
         "fee",
         "fee_coin",
         "is_maker",
         "exec_time"
        ],
        "properties": {
         "exec_id": {
          "type": "string",
          "maxLength": 64
         },
         "order_id": {
          "type": "string",
          "maxLength": 64
         },
         "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,24}$"
         },
         "base_coin": {
          "type": [
           "string",
           "null"
          ],
          "pattern": "^[A-Z0-9]{1,20}$"
         },
         "quote_coin": {
          "type": [
           "string",
           "null"
          ],
          "pattern": "^[A-Z0-9]{1,20}$"
         },
         "side": {
          "enum": [
           "buy",
           "sell"
          ]
         },
         "price": {
          "type": "string",
          "format": "decimal",
          "maxLength": 64
         },
         "qty": {
          "type": "string",
          "format": "decimal",
          "maxLength": 64
         },
         "value": {
          "type": "string",
          "format": "decimal",
          "maxLength": 64
         },
         "fee": {
          "type": "string",
          "format": "decimal",
          "maxLength": 64
         },
         "fee_coin": {
          "type": [
           "string",
           "null"
          ],
          "maxLength": 20
         },
         "is_maker": {
          "type": "boolean"
         },
         "exec_time": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
         }
        }
       }
      },
      "qty_unit": {
       "enum": [
        "base",
        "quote",
        null
       ]
      },
      "fills_total": {
       "type": "integer",
       "minimum": 0
      }
     }
    }
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ],
    "maxLength": 200
   },
   "freshness": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "as_of",
     "connection_state",
     "stream",
     "history_complete",
     "coverage_from",
     "last_reconcile_at"
    ],
    "properties": {
     "as_of": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     },
     "connection_state": {
      "enum": [
       "not_configured",
       "validating",
       "active",
       "degraded",
       "auth_failed",
       "ip_blocked",
       "key_expired",
       "secret_unavailable",
       "disconnected"
      ]
     },
     "stream": {
      "enum": [
       "live",
       "reconnecting",
       "down"
      ]
     },
     "last_reconcile_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     },
     "history_complete": {
      "type": "boolean"
     },
     "coverage_from": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "maxLength": 40
     }
    }
   }
  },
  "required": [
   "items",
   "next_cursor",
   "freshness"
  ]
 },
 "effect": "read",
 "scopes": [
  "trading.read"
 ],
 "surfaces": [
  "ui",
  "agent"
 ],
 "execution": {
  "mode": "sync",
  "max_duration_ms": 5000
 },
 "errors": [
  {
   "code": "not_configured",
   "meaning": "Ключ Bybit не подключён; данных нет",
   "recovery": "none"
  }
 ],
 "limits": {
  "max_response_bytes": 262144
 }
}

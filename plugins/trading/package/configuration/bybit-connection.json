{
 "contract": "assistant.configuration-schema/v1",
 "public_schema": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "environment": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9-]{1,30}$"
   },
   "label": {
    "type": "string",
    "minLength": 1,
    "maxLength": 64
   },
   "history_days": {
    "type": "integer",
    "minimum": 1,
    "maximum": 730,
    "default": 730
   }
  },
  "required": []
 },
 "secret_schema": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "type": "string",
    "pattern": "^[A-Za-z0-9]{10,64}$",
    "writeOnly": true
   },
   "api_secret": {
    "type": "string",
    "pattern": "^[A-Za-z0-9]{10,128}$",
    "writeOnly": true
   }
  },
  "required": [
   "api_key",
   "api_secret"
  ]
 },
 "scopes": {
  "read": [
   "trading.read"
  ],
  "write": [
   "trading.write"
  ]
 }
}
